{
  "rules": {
    "discussions": {
      "$bookId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          ".indexOn": ["timestamp"],
          "$messageId": {
            ".validate": "!newData.exists() || newData.hasChildren(['sender', 'senderUid', 'message', 'timestamp'])",
            "message": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 2000)"
            }
          }
        }
      }
    },
    "custom_threads": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdAt"],
      "$threadId": {
        ".validate": "!newData.exists() || newData.hasChildren(['id', 'title', 'creatorName', 'creatorUid', 'createdAt'])",
        "title": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 200)"
        }
      }
    }
  }
}