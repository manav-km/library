rules_version = '2';

// ==========================================================================
// Firestore security rules — SAJS Digital Library
//
// Role model: every /users/{uid} document has a `role` of "student",
// "teacher", or "admin". The client always writes role: "student" on
// signup — these rules enforce that server-side too, so a tampered client
// can never self-promote. Only an existing admin can change a role.
//
// Deploy with:
//   firebase deploy --only firestore:rules
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Hardcoded bootstrap list — mirrors ADMIN_EMAILS in auth.js.
    // This lets the admin operate even if their Firestore doc still
    // says role:"student" (i.e. before they've been self-promoted).
    function isAdminEmail() {
      return request.auth.token.email == "manavgmishra@gmail.com";
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function myRole() {
      return userDoc(request.auth.uid).role;
    }

    function isAdmin() {
      return isSignedIn() && (myRole() == "admin" || isAdminEmail());
    }

    function isTeacherOrAdmin() {
      return isSignedIn() && (myRole() == "teacher" || myRole() == "admin" || isAdminEmail());
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // users/{uid}
    //
    // Fields: uid, name, email, role, className, section, rollNumber,
    //         classTeacher, favouriteGenre, favouriteSubjects[], bio,
    //         profilePicture, subject, lastOnline, username, createdAt
    // ------------------------------------------------------------------
    match /users/{uid} {

      // Public read — needed for username lookup at login and for
      // the "Discover People" page.
      allow read: if true;

      // Account creation: only the user themselves.
      // Student role is always allowed; teacher role is allowed only
      // when the email ends with the official Jaipuria teacher suffix.
      allow create: if isOwner(uid)
                    && (
                      request.resource.data.role == "student"
                      || (
                        request.resource.data.role == "teacher"
                        && request.auth.token.email.matches(".*_lko@jaipuria\\.edu\\.in$")
                      )
                    )
                    && request.resource.data.uid == uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.email is string
                    && (!('classTeacher' in request.resource.data) || request.resource.data.classTeacher is string)
                    && (!('subject' in request.resource.data) || request.resource.data.subject is string)
                    && (!('favouriteSubjects' in request.resource.data) || request.resource.data.favouriteSubjects is list);

      // Self-edit: may update profile fields, but role and uid are frozen —
      // nobody can self-promote through a normal profile update.
      allow update: if isOwner(uid)
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.uid == resource.data.uid
                    && (
                      !('username' in request.resource.data)
                      || !('username' in resource.data)
                      || request.resource.data.username == resource.data.username
                    );

      // Admin override: may change role, edit any profile field, or delete.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // books/{docId}
    //
    // Fields: BK_ID, bookName, author, year, genre, coverImage, pdfUrl,
    //         mainIdea, themes[], characters[{name,role,note}], setting,
    //         plot, conflict, resolution, moral, summary, createdAt
    // ------------------------------------------------------------------
    match /books/{docId} {

      // Public catalogue — no sign-in required to browse.
      allow read: if true;

      allow create: if isTeacherOrAdmin()
                    && request.resource.data.BK_ID is string
                    // Enforces the permanent SAJS-### catalogue ID format.
                    && request.resource.data.BK_ID.matches("^SAJS-[0-9]{3,}$")
                    && request.resource.data.bookName is string
                    && request.resource.data.bookName.size() > 0
                    && request.resource.data.author is string
                    && request.resource.data.author.size() > 0
                    && request.resource.data.genre is string
                    && request.resource.data.genre.size() > 0;

      // Edits may change any field except the catalogue ID itself —
      // BK_ID is permanent once assigned.
      allow update: if isTeacherOrAdmin()
                    && request.resource.data.BK_ID == resource.data.BK_ID;

      allow delete: if isTeacherOrAdmin();
    }

    // ------------------------------------------------------------------
    // reviews/{docId}
    //
    // Fields: bookId, userId, userName, rating, reviewText,
    //         whyLiked, whatLearnt, canBeImproved, timestamp
    // ------------------------------------------------------------------
    match /reviews/{docId} {

      // Reviews are visible to anyone browsing a book.
      allow read: if true;

      // A signed-in user may only post a review as themselves, with a
      // valid 1–5 rating and non-empty text (max 2 000 chars).
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.bookId is string
                    && request.resource.data.bookId.size() > 0
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.reviewText is string
                    && request.resource.data.reviewText.size() > 0
                    && request.resource.data.reviewText.size() <= 2000;

      // Owner may edit their own review (rating / text) but cannot
      // reassign it to another book or author.
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.bookId == resource.data.bookId;

      // Delete: the review's own author, OR a teacher / admin moderating.
      allow delete: if isSignedIn()
                    && (resource.data.userId == request.auth.uid
                        || isTeacherOrAdmin());
    }

    // ------------------------------------------------------------------
    // schedules/{docId}
    //
    // Fields: weekId, date, day, period, gradeSection, teacherName,
    //         shelfGenre, activity, createdById, createdAt
    // ------------------------------------------------------------------
    match /schedules/{docId} {

      allow read: if isSignedIn();

      allow create: if isTeacherOrAdmin()
                    && request.resource.data.day is string
                    && request.resource.data.period is string
                    && request.resource.data.teacherName is string;

      allow update, delete: if isTeacherOrAdmin();
    }

    // ------------------------------------------------------------------
    // announcements/{docId}
    //
    // Fields: title, body, authorName, authorRole, createdAt
    // ------------------------------------------------------------------
    match /announcements/{docId} {

      // Announcements are public — shown on the dashboard to all users.
      allow read: if true;

      allow create: if isTeacherOrAdmin()
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0;

      allow update, delete: if isTeacherOrAdmin();
    }

    // ------------------------------------------------------------------
    // audit_logs/{docId}
    //
    // Fields: action, category, details, performedBy, targetId, timestamp,
    //         beforeEdit, afterEdit, deletedContent, reason
    // ------------------------------------------------------------------
    match /audit_logs/{docId} {

      // Only staff can read the audit trail.
      allow read: if isTeacherOrAdmin();

      // Any signed-in user may append a log entry (client-side logging),
      // but the action and category fields must be present strings.
      allow create: if isSignedIn()
                    && request.resource.data.action is string
                    && request.resource.data.category is string
                    && (!('beforeEdit' in request.resource.data) || request.resource.data.beforeEdit is string)
                    && (!('afterEdit' in request.resource.data) || request.resource.data.afterEdit is string)
                    && (!('deletedContent' in request.resource.data) || request.resource.data.deletedContent is string)
                    && (!('reason' in request.resource.data) || request.resource.data.reason is string);

      // Log entries are immutable — no updates or deletes.
    }

    // ------------------------------------------------------------------
    // readingLists/{uid}
    //
    // Fields: shelves (map of array of book IDs), updatedAt
    // ------------------------------------------------------------------
    match /readingLists/{uid} {
      allow read: if isOwner(uid) || isTeacherOrAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ------------------------------------------------------------------
    // readingProgress/{progressId}
    //
    // Fields: uid, bookId, currentPage, totalPages, status, updatedAt
    // ------------------------------------------------------------------
    match /readingProgress/{progressId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // challenges/{challengeId}
    //
    // Fields: title, description, goal, goalType, startDate, endDate,
    //         createdBy, active, createdAt
    // ------------------------------------------------------------------
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // ------------------------------------------------------------------
    // bookIssues/{issueId}
    //
    // Fields: bookId, bookName, userId, userName, userClass, userSection,
    //         reason, issueDate, returnDate, status, requestedAt, updatedAt
    // ------------------------------------------------------------------
    match /bookIssues/{issueId} {
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || isTeacherOrAdmin());
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isTeacherOrAdmin();
    }

    // ------------------------------------------------------------------
    // Deny everything else by default
    // ------------------------------------------------------------------
  }
}

// ==========================================================================
// Firebase Storage rules — SAJS Digital Library
// ==========================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Book cover images
    match /covers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Book PDFs
    match /pdfs/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 100 * 1024 * 1024;
    }

    // Profile pictures
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}

