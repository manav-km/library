{
  "rules": {
    "discussions": {
      "$bookId": {
        "messages": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": [
            "timestamp"
          ],
          "$messageId": {
            ".validate": "newData.hasChildren(['sender', 'senderUid', 'message', 'timestamp'])",
            "message": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
            }
          }
        }
      }
    },
    "custom_threads": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "createdAt"
      ],
      "$threadId": {
        ".validate": "newData.hasChildren(['id', 'title', 'creatorName', 'creatorUid', 'createdAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        }
      }
    }
  }
}