{
  "rules": {
    "discussions": {
      "$bookId": {
        "messages": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": [
            "timestamp"
          ],
          "$messageId": {
            ".validate": "newData.hasChildren(['sender', 'senderUid', 'message', 'timestamp'])"
          }
        }
      }
    },
    "custom_threads": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "createdAt"
      ],
      "$threadId": {
        ".validate": "newData.hasChildren(['id', 'title', 'creatorName', 'creatorUid', 'createdAt'])"
      }
    }
  }
}